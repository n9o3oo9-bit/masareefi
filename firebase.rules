// قواعد أمان Firestore — الصقها في:
// Firebase Console ← Firestore Database ← Rules ← Publish
//
// المعنى: كل مستخدم يقرأ ويكتب مستنده فقط. لا أحد غيرك يصل لبياناتك،
// حتى لو كان رابط التطبيق عامًا ومفاتيح الإعداد ظاهرة في الكود.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // أي شيء آخر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
